# ===================================================================
# WMA HUB - Configuration d'Environnement (.env.example)
# Modèle de configuration pour le projet WMA HUB
# Copiez ce fichier sous le nom '.env' et configurez vos identifiants.
# ===================================================================

# Application
APP_ENV=production
APP_URL=https://wmahub.com

# Base de Données MySQL
DB_HOST=localhost
DB_NAME=wmahubco_hub
DB_USER=wmahubco_hub
DB_PASSWORD=your_database_password_here

# Google OAuth (Authentification Site Web)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=

# Firebase (Authentification App Mobile)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# Apple OAuth (Service ID)
APPLE_CLIENT_ID=your_apple_service_id
APPLE_REDIRECT_URL=

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key

# Passerelle de Paiement FlexPay
FLEXPAY_MERCHANT=your_merchant_code
FLEXPAY_TOKEN=your_flexpay_bearer_token
FLEXPAY_API_URL=http://backend.flexpay.cd/api/rest/v1/paymentService

# Serveur SMTP (PHPMailer)
SMTP_HOST=mail.wmahub.com
SMTP_PORT=465
SMTP_USERNAME=noreply@wmahub.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME="WMA HUB"
SMTP_FROM_EMAIL=noreply@wmahub.com

# Adresses & Contacts Métier
DEV_ALERT_EMAIL=admin@wmahub.com
SUPPORT_EMAIL=info@wmahub.com
WHATSAPP_NUMBER=243000000000
ADMIN_NOTIFICATION_EMAILS=info@wmahub.com
SUBSCRIPTION_NOTIFICATION_EMAIL=abonnement@wmahub.com

# Sécurité & Maintenance Base de Données
DB_SYNC_KEY=your_secret_db_sync_key
DB_SYNC_PASSCODE=your_secret_passcode
